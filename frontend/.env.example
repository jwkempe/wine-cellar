# Frontend environment variables.
# Copy to .env.local and fill in real values:  cp .env.example .env.local
# In production these are set in the Vercel dashboard (Settings → Environment Variables).

# Backend API base URL. Defaults to the local backend if unset.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Clerk keys — https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxx
