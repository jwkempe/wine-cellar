# Backend environment variables.
# Copy to .env and fill in real values:  cp .env.example .env
# In production these are set in the Railway dashboard (service → Variables).

# ── Required (the backend refuses to start without these) ──────────────────

# Postgres connection string.
# Locally, use the PUBLIC url from Railway's Postgres service → "Connect" tab —
# the internal *.railway.internal host only resolves inside Railway's network.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Claude API key — https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Clerk JWKS endpoint, used to verify session JWTs. Clerk dashboard → API Keys
# (Show JWKS URL). Example:
# https://your-instance.clerk.accounts.dev/.well-known/jwks.json
CLERK_JWKS_URL=

# ── Optional (defaults shown; uncomment to override) ───────────────────────

# Model for the free-text sommelier features
# ANTHROPIC_MODEL=claude-opus-4-8

# Model for web-search market-value lookups (cheap extraction task)
# ANTHROPIC_VALUE_MODEL=claude-haiku-4-5

# Per-user cap on AI calls per minute (wallet protection)
# AI_RATE_LIMIT_PER_MINUTE=20

# Bulk valuation: max bottles per run, and how many to value in parallel
# BULK_VALUE_LIMIT=60
# VALUE_CONCURRENCY=5

# Comma-separated exact CORS origins
# ALLOWED_ORIGINS=http://localhost:3000

# CORS regex for Vercel preview/production deploys
# ALLOWED_ORIGIN_REGEX=https://wine-cellar.*\.vercel\.app
